# WiFi and BLE development node. Replace the lab values locally. Do not commit
# actual credentials.
CONFIG_LM_WIFI_ENABLE=y
CONFIG_LM_WIFI_SSID="latentmesh-lab"
CONFIG_LM_WIFI_PASSWORD="replace-locally"
CONFIG_LM_WIFI_UDP_PEER_IPV4="192.0.2.10"
CONFIG_LM_WIFI_UDP_BIND_PORT=40404
CONFIG_LM_WIFI_UDP_PEER_PORT=40404
CONFIG_LM_BLE_ENABLE=y
CONFIG_LM_UART_KISS_ENABLE=n
CONFIG_LM_I2S_AUDIO_ENABLE=n
CONFIG_LM_RF_TX_ENABLE=n
